# Черновик профиля AppArmor контейнера портала SwarmLab (M9b; проверка — docs/ROADMAP.md).
#
# Это профиль Docker по умолчанию (docker-default) с тремя отличиями — их требует nsjail,
# который внутри контейнера запускает раннер кода игрока в своих пространствах имён:
#   userns,       создание пространства пользователей (Ubuntu ≥ 23.10 запрещает его
#                 профилям без этого правила: kernel.apparmor_restrict_unprivileged_userns=1);
#   mount,        монтирование внутри своего пространства (корень песочницы, только чтение);
#   pivot_root,   смена корня песочницы.
# Без CAP_SYS_ADMIN в пространстве хоста (контейнер без --privileged и --cap-add) монтировать
# можно только внутри своего пространства пользователей.
#
# Загрузить на хосте (один раз и после изменения файла):
#   sudo apparmor_parser -r -W /opt/swarmlab/docker/apparmor-swarmlab-sandbox
# Контейнер: --security-opt apparmor=swarmlab-sandbox

abi <abi/4.0>,

#include <tunables/global>

profile swarmlab-sandbox flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  userns,
  mount,
  pivot_root,

  # Сигналы от хоста и dockerd (docker stop / kill) и между процессами контейнера.
  signal (receive) peer=unconfined,
  signal (send,receive) peer=swarmlab-sandbox,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=swarmlab-sandbox,
}
